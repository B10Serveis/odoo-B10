<odoo>
    <record id="sale_subscription_form_b10" model="ir.ui.view">
        <field name="name">sale.subscription.form.b10</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="subscription_oca.sale_subscription_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="company_id" invisible="1" />
                <field
                    name="payment_mode_id"
                    domain="[('payment_type', '=', 'inbound'), ('company_id', '=', company_id)]"
                />
            </xpath>
            <xpath
                expr="//field[@name='sale_subscription_line_ids']/tree/field[@name='tax_ids']"
                position="before"
            >
                <field name="display_type" invisible="1" />
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    options="{'product_field': 'product_id'}"
                    groups="analytic.group_analytic_accounting"
                    attrs="{'invisible': [('display_type', '!=', False)]}"
                />
            </xpath>
        </field>
    </record>

    <record id="sale_subscription_line_form_b10" model="ir.ui.view">
        <field name="name">sale.subscription.line.form.b10</field>
        <field name="model">sale.subscription.line</field>
        <field name="inherit_id" ref="subscription_oca.sale_subscription_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    options="{'product_field': 'product_id'}"
                    groups="analytic.group_analytic_accounting"
                />
            </xpath>
        </field>
    </record>
</odoo>
