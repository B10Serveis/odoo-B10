<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_pos_closing_report">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h2 class="text-center" style="margin: 0 0 8px; font-size: 24px;">
                            POS CLOSING REPORT
                        </h2>
                        <p style="margin-bottom: 8px;">
                            <strong>Point of Sale: </strong>
                            <span t-esc="config.name"/>
                            <span style="padding: 0 5px;">|</span>
                            <strong>Period:</strong>
                            <span> </span>
                            <span t-esc="date_start" t-options="{'widget': 'date'}"/>
                            <span> - </span>
                            <span t-esc="date_stop" t-options="{'widget': 'date'}"/>
                        </p>

                        <t t-if="not sessions">
                            <p>No closed sessions found for the selected period.</p>
                        </t>
                        <t t-foreach="sessions" t-as="row">
                            <t t-set="session" t-value="row['session']"/>
                            <div style="page-break-inside: avoid; margin-bottom: 12px;">
                                <table class="table table-sm" style="table-layout: fixed; width: 100%; margin-bottom: 0;">
                                    <colgroup>
                                        <col style="width: 18%;"/>
                                        <col style="width: 25%;"/>
                                        <col style="width: 30%;"/>
                                        <col style="width: 27%;"/>
                                    </colgroup>
                                    <thead>
                                        <tr style="border-bottom: 1px solid #343a40;">
                                            <th style="text-align: left;">Session</th>
                                            <th style="text-align: left;">Opening Date</th>
                                            <th style="text-align: left;">Closing Date</th>
                                            <th style="text-align: left;">Point of Sale</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="background-color: #d2d2d2; page-break-inside: avoid;">
                                            <td><span t-field="session.name"/></td>
                                            <td><span t-field="session.start_at" t-options="{'widget': 'date'}"/></td>
                                            <td><span t-field="session.stop_at" t-options="{'widget': 'date'}"/></td>
                                            <td><span t-field="session.config_id"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="table table-sm" style="table-layout: fixed; width: 100%; margin-bottom: 0;">
                                    <colgroup>
                                        <col style="width: 50%;"/>
                                        <col style="width: 25%;"/>
                                        <col style="width: 25%;"/>
                                    </colgroup>
                                    <thead>
                                        <tr style="border-bottom: 1px solid #343a40;">
                                            <th style="text-align: left;">Payment Method</th>
                                            <th style="text-align: right;">Sold</th>
                                            <th style="text-align: right;">Declared</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="row['payments']" t-as="payment" style="page-break-inside: avoid;">
                                            <td style="text-align: left;"><span t-esc="payment['name']"/></td>
                                            <td style="text-align: right;">
                                                <span t-esc="payment['sold']" t-options="{'widget': 'monetary', 'display_currency': session.currency_id}"/>
                                            </td>
                                            <td style="text-align: right;">
                                                <span t-if="payment['declared'] is not None" t-esc="payment['declared']" t-options="{'widget': 'monetary', 'display_currency': session.currency_id}"/>
                                                <span t-else="">—</span>
                                            </td>
                                        </tr>
                                        <tr t-if="not row['payments']">
                                            <td colspan="3">No payments recorded for this session.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
