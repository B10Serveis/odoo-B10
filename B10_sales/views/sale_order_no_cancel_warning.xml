<odoo>
    <data>
        <record id="sale_order_view_inherit2"
            model="ir.ui.view">
            <field name="name">sale.order.custom.form.inherited2</field>
            <field name="model">sale.order</field>
            <field name="inherit_id"
                ref="sale.view_order_form"/>
            <field name="arch"
                type="xml">
                <xpath expr="//button[@name='action_cancel']"
                    position="attributes">
                    <attribute name="context">{'disable_cancel_warning': True}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
