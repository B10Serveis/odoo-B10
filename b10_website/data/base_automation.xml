<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="automation_anonymous_customers" model="base.automation">
            <field name="name">Marcar particulars sense NIF com a anònims AEAT</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="trigger">on_create_or_write</field>
            <field name="filter_domain">[
                ('vat', '=', False),
                ('is_company', '=', False),
                ('aeat_anonymous_cash_customer', '=', False)
            ]</field>
            <field name="active" eval="True"/>
        </record>

        <record id="action_anonymous_customers" model="ir.actions.server">
            <field name="name">Marcar client anònim AEAT</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="usage">base_automation</field>
            <field name="base_automation_id" ref="automation_anonymous_customers"/>
            <field name="state">code</field>
            <field name="code">records.write({'aeat_anonymous_cash_customer': True})</field>
        </record>

        <record id="automation_identified_customers" model="base.automation">
            <field name="name">Desmarcar clients anònims AEAT amb NIF</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="trigger">on_create_or_write</field>
            <field name="filter_domain">[
                ('vat', '!=', False),
                ('aeat_anonymous_cash_customer', '=', True)
            ]</field>
            <field name="active" eval="True"/>
        </record>

        <record id="action_identified_customers" model="ir.actions.server">
            <field name="name">Desmarcar client anònim AEAT</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="usage">base_automation</field>
            <field name="base_automation_id" ref="automation_identified_customers"/>
            <field name="state">code</field>
            <field name="code">records.write({'aeat_anonymous_cash_customer': False})</field>
        </record>
    </data>
</odoo>
