<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Herència de la vista de partner per afegir Accessos Proveïdor -->
    <record id="view_partner_form_b10_purchases" model="ir.ui.view">
      <field name="name">b10.purchases.partner.form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form" />
      <field name="arch" type="xml">

        <!-- Afegim el camp supplier_rank dins un xpath vàlid -->
        <xpath expr="//sheet" position="inside">
          <field name="supplier_rank" invisible="1"/>
        </xpath>

        <!-- Checkbox per habilitar la pestanya Accessos -->
        <xpath expr="//sheet/notebook" position="before">
          <group attrs="{'invisible': [('supplier_rank','=',0)]}">
            <field name="x_is_provider_access"
                   string="Provider Access"/>
          </group>
        </xpath>

        <!-- Pestanya “Access” amb les credencials i condició de visibilitat -->
        <xpath expr="//sheet/notebook" position="inside">
          <page string="Access"
                attrs="{'invisible': ['|',
                                      ('x_is_provider_access','=',False),
                                      ('supplier_rank','=',0)]}">
            <field name="provider_credential_ids">
              <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url" placeholder="https://example.com"/>
                <field name="user" placeholder="user@example.com"/>
                <field name="password" placeholder="••••••••" widget="password"
                       groups="B10_purchases.group_b10_pwd_manager"/>
                <field name="password" placeholder="••••••••" widget="password"
                       readonly="1" groups="B10_purchases.group_b10_pwd_reader"/>
              </tree>
              <form>
                <sheet>
                  <group>
                    <field name="name"/>
                    <field name="url" placeholder="https://example.com"/>
                    <field name="user" placeholder="user@example.com"/>
                    <field name="password" placeholder="••••••••" widget="password"
                           groups="B10_purchases.group_b10_pwd_manager"/>
                    <field name="password" placeholder="••••••••" widget="password"
                           readonly="1" groups="B10_purchases.group_b10_pwd_reader"/>
                  </group>
                </sheet>
              </form>
            </field>
          </page>
        </xpath>

      </field>
    </record>
  </data>
</odoo>
