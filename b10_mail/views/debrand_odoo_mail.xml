<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="debrand_odoo_inherit_mail_notification"
              inherit_id="mail.mail_notification_layout">
        <xpath expr="//div[@summary='o_mail_notification']" position="before">
            <div t-if="company and not company.uses_default_logo" style="margin: 5px 0 10px;">
                <img t-att-src="'/logo.png?company=%s' % company.id"
                     t-att-alt="company.name"
                     style="display: block; height: auto; max-width: 200px; max-height: 36px;"/>
            </div>
        </xpath>
        <xpath expr="//div[@summary='o_mail_notification']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@t-if='show_footer'][b[@t-out='company.name']]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@t-if='show_footer'][span[@id='mail_unfollow']]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
