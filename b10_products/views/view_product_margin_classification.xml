<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_view_product_product_by_margin_classification"
            model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_product_tree"/>
    </record>

    <record id="view_product_margin_classification_tree"
            model="ir.ui.view">
        <field name="name">product.margin.classification.tree</field>
        <field name="model">product.margin.classification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="profit_margin"/>
                <field name="product_too_cheap_qty"/>
                <field name="product_too_expensive_qty"/>
                <field name="product_qty"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_product_margin_classification_form"
            model="ir.ui.view">
        <field name="model">product.margin.classification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="apply_theoretical_price"
                            type="object"
                            string="Apply Theoretical Price"
                            invisible="product_incorrect_price_qty == 0"/>
                    <button name="apply_theoretical_price_too_cheap"
                            type="object"
                            string="Up to Theoretical Price"
                            invisible="product_too_cheap_qty == 0"/>
                    <button name="apply_theoretical_price_too_expensive"
                            type="object"
                            string="Down to Theoretical Price"
                            invisible="product_too_expensive_qty == 0"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group col="4">
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Settings">
                            <group col="4" string="Computation Method">
                                <label for="profit_margin"/>
                                <div>
                                    <field name="profit_margin"
                                           class="oe_inline"
                                           required="True"/>
                                </div>
                                <label for="markup"/>
                                <div>
                                    <field name="markup"
                                           class="oe_inline"/>
                                </div>
                                <field name="price_round"/>
                                <field name="price_surcharge"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_margin_classification_form_stat_inherit"
        model="ir.ui.view">
        <field name="name">product.margin.classification.form.stat.buttons</field>
        <field name="model">product.margin.classification</field>
        <field name="inherit_id" ref="b10_products.view_product_margin_classification_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="replace">
                <div class="oe_title o_row d-flex justify-content-between align-items-center">
                    <h1 class="o_heading_text">
                        <field name="name"/>
                    </h1>
                    <div class="btn-group o_stat_buttons">
                        <button name="%(action_view_product_product_by_margin_classification)d"
                                type="action"
                                class="btn btn-outline-secondary btn-sm"
                                icon="fa-list"
                                context="{'search_default_margin_classification_id': id}"
                                invisible="product_qty == 0">
                            <field name="product_qty" widget="statinfo" string=" Products"/>
                        </button>
                        <button name="%(action_view_product_product_by_margin_classification)d"
                                type="action"
                                class="btn btn-outline-secondary btn-sm"
                                icon="fa-check"
                                context="{'search_default_margin_classification_id': id,
                                        'search_default_filter_margin_correct': True}"
                                invisible="product_correct_price_qty == 0">
                            <field name="product_correct_price_qty" widget="statinfo" string=" Correct"/>
                        </button>
                        <button name="%(action_view_product_product_by_margin_classification)d"
                                type="action"
                                class="btn btn-outline-secondary btn-sm"
                                icon="fa-exclamation-triangle"
                                context="{'search_default_margin_classification_id': id,
                                        'search_default_filter_margin_incorrect': True}"
                                invisible="product_incorrect_price_qty == 0">
                            <field name="product_incorrect_price_qty" widget="statinfo" string=" Incorrect"/>
                        </button>
                        <button name="%(action_view_product_product_by_margin_classification)d"
                                type="action"
                                class="btn btn-outline-secondary btn-sm"
                                icon="fa-minus"
                                context="{'search_default_margin_classification_id': id,
                                        'search_default_filter_margin_too_cheap': True}"
                                invisible="product_too_cheap_qty == 0">
                            <field name="product_too_cheap_qty" widget="statinfo" string=" Too Cheap"/>
                        </button>
                        <button name="%(action_view_product_product_by_margin_classification)d"
                                type="action"
                                class="btn btn-outline-secondary btn-sm"
                                icon="fa-plus"
                                context="{'search_default_margin_classification_id': id,
                                        'search_default_filter_margin_too_expensive': True}"
                                invisible="product_too_expensive_qty == 0">
                            <field name="product_too_expensive_qty" widget="statinfo" string=" Too Priced"/>
                        </button>
                    </div>
                </div>
            </xpath>
        </field>
    </record>



    <record id="action_product_margin_classification"
            model="ir.actions.act_window">
        <field name="name">Margin Classifications</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.margin.classification</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_margin_classification"
              parent="sale.prod_config_main"
              action="action_product_margin_classification"
              sequence="5"/>

</odoo>
