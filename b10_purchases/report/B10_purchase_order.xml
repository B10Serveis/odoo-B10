<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="B10_purchase_order_action"
		model="ir.actions.report">
		<field name="name">Standard purchase order</field>
		<field name="model">purchase.order</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">b10_purchases.B10_purchase_order_report</field>
		<field name="report_file">b10_purchases.B10_purchase_order_report</field>
		<field name="print_report_name">'PurchOrder_%s' % (object.name)</field>
		<field name="binding_model_id"
			ref="purchase.model_purchase_order"/>
		<field name="binding_type">report</field>
	</record>
</odoo>
