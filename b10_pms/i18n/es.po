#. module: b10_pms
#: model:mail.template,name:b10_pms.mail_template_reservation_confirmation
msgid "B10 - Hotel Reservation Confirmation"
msgstr "B10 - Confirmación de reserva de hotel"

#. module: b10_pms
#: model:mail.template,subject:b10_pms.mail_template_reservation_confirmation
msgid ""
"{{ object.pms_property_id.name }} - Reservation {{ object.name }} confirmed"
msgstr ""
"{{ object.pms_property_id.name }} - Reserva {{ object.name }} confirmada"

#. module: b10_pms
#: model:mail.template,body_html:b10_pms.mail_template_reservation_confirmation
msgid ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: white; font-family: Verdana, Arial, sans-serif; color: #454748; width: 100%; border-collapse: separate;\">\n"
"                <tbody>\n"
"                    <tr>\n"
"                        <td align=\"center\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; color: #454748; border-collapse: separate; background-color: #F1F1F1;\">\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" t-attf-style=\"min-width: 590px; padding: 0 8px; border-bottom: solid gray 2px; border-collapse: separate; background-color: {{ object.company_id.primary_color or 'gray' }};\">\n"
"                                                <tbody>\n"
"                                                    <tr>\n"
"                                                        <td valign=\"middle\" style=\"padding: 16px; font-size: 20px; font-weight: bold; color: white;\">\n"
"                                                            Reservation confirmed\n"
"                                                        </td>\n"
"                                                        <td align=\"right\" valign=\"middle\">\n"
"                                                            <img t-attf-src=\"/web/image/pms.property/{{ object.pms_property_id.id }}/logo\" t-att-alt=\"object.pms_property_id.name\" style=\"padding: 8px 16px; height: auto; width: 100px;\">\n"
"                                                        </td>\n"
"                                                    </tr>\n"
"                                                </tbody>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0 8px; border-collapse: separate;\">\n"
"                                                <tbody>\n"
"                                                    <tr>\n"
"                                                        <td valign=\"top\" style=\"font-size: 13px; padding: 16px;\">\n"
"                                                            <p>\n"
"                                                                Dear\n"
"                                                                <t t-out=\"object.partner_id.name or '-'\"></t>,\n"
"                                                            </p>\n"
"                                                            <p>\n"
"                                                                We are pleased to confirm your reservation at\n"
"                                                                <strong><t t-out=\"object.pms_property_id.name or '-'\"></t></strong>.\n"
"                                                            </p>\n"
"                                                            <p style=\"font-size: 16px; font-weight: bold; margin-top: 24px;\">Reservation details</p>\n"
"                                                            <table border=\"0\" cellpadding=\"5\" cellspacing=\"0\" width=\"100%\" style=\"font-size: 13px; border-collapse: collapse;\">\n"
"                                                                <tbody>\n"
"                                                                    <tr>\n"
"                                                                        <td style=\"width: 35%; color: #777777;\">Reference</td>\n"
"                                                                        <td><strong><t t-out=\"object.name or '-'\"></t></strong></td>\n"
"                                                                    </tr>\n"
"                                                                    <tr>\n"
"                                                                        <td style=\"color: #777777;\">Check-in</td>\n"
"                                                                        <td><t t-out=\"format_date(object.first_checkin) if object.first_checkin else '-'\"></t></td>\n"
"                                                                    </tr>\n"
"                                                                    <tr>\n"
"                                                                        <td style=\"color: #777777;\">Check-out</td>\n"
"                                                                        <td><t t-out=\"format_date(object.last_checkout) if object.last_checkout else '-'\"></t></td>\n"
"                                                                    </tr>\n"
"                                                                    <tr>\n"
"                                                                        <td style=\"color: #777777;\">Rooms and guests</td>\n"
"                                                                        <td>\n"
"                                                                            <t t-foreach=\"object.reservation_ids.filtered(lambda reservation: reservation.state != 'cancel')\" t-as=\"reservation\">\n"
"                                                                                <div>\n"
"                                                                                    <t t-out=\"reservation.room_type_id.name or '-'\"></t>\n"
"                                                                                    —\n"
"                                                                                    <t t-out=\"reservation.adults or 0\"></t> adult(s),\n"
"                                                                                    <t t-out=\"reservation.children or 0\"></t> child(ren)\n"
"                                                                                </div>\n"
"                                                                            </t>\n"
"                                                                        </td>\n"
"                                                                    </tr>\n"
"                                                                    <tr>\n"
"                                                                        <td style=\"color: #777777;\">Total</td>\n"
"                                                                        <td><strong><t t-out=\"format_amount(object.amount_total, object.currency_id)\"></t></strong></td>\n"
"                                                                    </tr>\n"
"                                                                </tbody>\n"
"                                                            </table>\n"
"                                                            <t t-if=\"object.pms_property_id.mail_information\">\n"
"                                                                <p style=\"font-size: 16px; font-weight: bold; margin-top: 24px;\">Additional information</p>\n"
"                                                                <div t-out=\"object.pms_property_id.mail_information\"></div>\n"
"                                                            </t>\n"
"                                                            <p style=\"margin-top: 24px;\">\n"
"                                                                If you have any questions about your reservation, please contact us.\n"
"                                                            </p>\n"
"                                                            <p>\n"
"                                                                Kind regards,<br>\n"
"                                                                <strong><t t-out=\"object.pms_property_id.name or object.company_id.name\"></t></strong>\n"
"                                                            </p>\n"
"                                                        </td>\n"
"                                                    </tr>\n"
"                                                </tbody>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: #F1F1F1; font-size: 11px; margin-top: 16px; padding: 8px; border-collapse: separate;\">\n"
"                                                <tbody>\n"
"                                                    <tr>\n"
"                                                        <td align=\"left\" style=\"font-size: 14px; font-weight: bold;\">\n"
"                                                            <t t-out=\"object.pms_property_id.name or '-'\"></t>\n"
"                                                        </td>\n"
"                                                    </tr>\n"
"                                                    <tr>\n"
"                                                        <td align=\"left\" style=\"opacity: 0.7; padding-top: 4px;\">\n"
"                                                            <t t-if=\"object.pms_property_id.partner_id.phone\">\n"
"                                                                <t t-out=\"object.pms_property_id.partner_id.phone\"></t>\n"
"                                                            </t>\n"
"                                                            <t t-if=\"object.pms_property_id.partner_id.email\">\n"
"                                                                |\n"
"                                                                <a t-attf-href=\"mailto:{{ object.pms_property_id.partner_id.email }}\" style=\"text-decoration: none; color: #454748;\" t-out=\"object.pms_property_id.partner_id.email\"></a>\n"
"                                                            </t>\n"
"                                                            <t t-if=\"object.pms_property_id.website\">\n"
"                                                                |\n"
"                                                                <a t-att-href=\"object.pms_property_id.website\" style=\"text-decoration: none; color: #454748;\" t-out=\"object.pms_property_id.website\"></a>\n"
"                                                            </t>\n"
"                                                        </td>\n"
"                                                    </tr>\n"
"                                                    <tr t-if=\"object.pms_property_id.privacy_policy\">\n"
"                                                        <td align=\"left\" style=\"font-size: 10px; color: #454748; padding-top: 12px;\">\n"
"                                                            <div t-out=\"object.pms_property_id.privacy_policy\"></div>\n"
"                                                        </td>\n"
"                                                    </tr>\n"
"                                                </tbody>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                </tbody>\n"
"            </table>\n"
"        "
