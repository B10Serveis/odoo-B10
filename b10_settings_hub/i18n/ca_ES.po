#: model_terms:ir.ui.view,arch_db:b10_settings_hub.view_res_config_settings_b10
msgid "Account"
msgstr "Comptabilitat"

#. module: b10_settings_hub
#: model_terms:ir.ui.view,arch_db:b10_settings_hub.view_res_config_settings_b10
msgid ""
"Adds billing enhancements: auto-assign partner bank by payment method, group invoice\n"
"                   lines by source with clear PDF headers, improved reports/emails, and safeguards against\n"
"                    duplicate bank accounts per partner."
msgstr ""
"Afegeix millores de facturació: assignació automàtica del banc del client segons el mètode de pagament, agrupació de línies de factura per origen amb capçaleres clares en PDF, informes i correus millorats, i protecció contra comptes bancaris duplicats per client."

#. module: b10_settings_hub
#: model_terms:ir.ui.view,arch_db:b10_settings_hub.view_res_config_settings_b10
msgid ""
"Adds internal notes and closing notes fields plus extra utilities on top of "
"the OCA Helpdesk module."
msgstr ""
"Afegeix camps de notes internes i de tancament, així com utilitats extres sobre el mòdul OCA Helpdesk."

