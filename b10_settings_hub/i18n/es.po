#: model_terms:ir.ui.view,arch_db:b10_settings_hub.view_res_config_settings_b10
msgid "Account"
msgstr "Contabilidad"

#. module: b10_settings_hub
#: model_terms:ir.ui.view,arch_db:b10_settings_hub.view_res_config_settings_b10
msgid ""
"Adds billing enhancements: auto-assign partner bank by payment method, group invoice\n"
"                   lines by source with clear PDF headers, improved reports/emails, and safeguards against\n"
"                    duplicate bank accounts per partner."
msgstr ""
"Añade mejoras de facturación: asignación automática del banco del cliente según el método de pago, agrupación de líneas de factura por origen con cabeceras claras en PDF, informes/correos mejorados y protección contra cuentas bancarias duplicadas por cliente."

#. module: b10_settings_hub
#: model_terms:ir.ui.view,arch_db:b10_settings_hub.view_res_config_settings_b10
msgid ""
"Adds internal notes and closing notes fields plus extra utilities on top of "
"the OCA Helpdesk module."
msgstr ""
"Añade campos de notas internas y de cierre, además de utilidades extra sobre el módulo OCA Helpdesk."

