<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit_b10_account_payable_domain"
        model="ir.ui.view">
        <field name="name">res.partner.form.inherit.b10.account_payable_domain</field>
        <field name="model">res.partner</field>
        <field name="inherit_id"
            ref="base.view_partner_form"/>
        <field name="arch"
            type="xml">
            <xpath expr="//field[@name='property_account_payable_id']"
                position="attributes">
                <attribute name="domain">[('user_type_id.internal_group','=','liability'), ('deprecated','=',False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>