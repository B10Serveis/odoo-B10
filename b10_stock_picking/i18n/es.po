#. module: b10_stock_picking
#: model:mail.template,body_html:b10_stock_picking.entrega_email_template
msgid ""
"<table style=\"padding-top: 16px; background-color: white; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n"
"    <tbody>\n"
"        <tr>\n"
"            <td align=\"center\">\n"
"                <table t-attf-style=\"padding: 16px; color: #454748; border-collapse:separate; background-color: #F1F1F1\" width=\"590\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n"
"                    <tbody>\n"
"                        <!-- HEADER -->\n"
"                        <tr>\n"
"                            <td style=\"min-width: 590px;\" align=\"center\">\n"
"                                <table t-attf-style=\"min-width: 590px; padding: 0px 8px; border-bottom: solid gray 2px; border-collapse:separate; background-color: {{ object.company_id.primary_color or 'gray'}}\" width=\"590\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n"
"                                    <tbody>\n"
"                                        <tr>\n"
"                                            <td valign=\"middle\" style=\"padding: 16px; font-size: 20px; font-weight: bold; color: white;\">\n"
"                                                <span>Entrega de </span>\n"
"                                                <t t-out=\"object.company_id.name or '-'\" data-oe-t-inline=\"true\" contenteditable=\"false\"/>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </tbody>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <!-- CONTENT -->\n"
"                        <tr>\n"
"                            <td style=\"min-width: 590px;\" align=\"center\">\n"
"                                <table style=\"min-width: 590px; background-color: white; padding: 0px 8px; border-collapse:separate;\" width=\"590\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n"
"                                    <tbody>\n"
"                                        <tr>\n"
"                                            <td style=\"font-size: 13px; padding: 16px;\" valign=\"top\">\n"
"                                                <div>\n"
"                                                    Estimado/a \n"
"                                                    <t t-out=\"object.partner_id.name or object.partner_id.comercial or object.partner_id.parent_id.name or '-'\"/>\n"
"                                                    <br/>\n"
"                                                    Su entrega ha sido enviada.\n"
"                                                    <br/>\n"
"                                                    Aquí tiene los detalles de su entrega:\n"
"                                                    <br/>\n"
"                                                    <p style=\"margin-left: 16px\">\n"
"                                                        Número de entrega: \n"
"                                                        <span style=\"font-weight: bold;\">\n"
"                                                            <t t-out=\"object.name or 'n/a'\" data-oe-t-inline=\"true\" contenteditable=\"false\"/>\n"
"                                                        </span>\n"
"                                                        <br/>\n"
"                                                        Fecha programada de entrega: \n"
"                                                        <t t-out=\"format_date(object.scheduled_date) or '-'\" data-oe-t-inline=\"true\" contenteditable=\"false\"/>\n"
"                                                    </p>\n"
"                                                </div>\n"
"                                            </td>\n"
"                                            <!-- LOGO -->\n"
"                                            <td valign=\"top\" align=\"right\">\n"
"                                                <img t-attf-src=\"/logo.png?company={{ object.company_id.id }}\" style=\"height:auto; width:100px; margin:16px;\" t-att-alt=\"object.company_id.name\"/>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </tbody>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <!-- FOOTER -->\n"
"                        <tr>\n"
"                            <td style=\"min-width: 590px;\" align=\"center\">\n"
"                                <table style=\"min-width:590px; background-color:#F1F1F1; font-size:11px; margin-top:16px; padding:0px 8px; border-collapse:separate;\" width=\"590\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n"
"                                    <tbody>\n"
"                                        <tr>\n"
"                                            <td style=\"opacity:0.7;\" valign=\"middle\" align=\"left\">\n"
"                                                <t t-out=\"user.signature or '-'\" data-oe-t-inline=\"true\" contenteditable=\"false\"/>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                        <tr>\n"
"                                            <td valign=\"middle\" align=\"left\" style=\"font-size:14px; font-weight:bold;\">\n"
"                                                <t t-out=\"object.company_id.name or '-'\" data-oe-t-inline=\"true\" contenteditable=\"false\"/>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                        <tr>\n"
"                                            <td style=\"opacity:0.7;\" valign=\"middle\" align=\"left\">\n"
"                                                <t t-out=\"user.phone or '-'\" data-oe-t-inline=\"true\" contenteditable=\"false\"/>\n"
"                                                <t t-if=\"user.email\" data-oe-t-group=\"0\" data-oe-t-group-active=\"true\">\n"
"                                                    | <a t-attf-href=\"'mailto:%s' % {{ user.email }}\" style=\"text-decoration:none; color:#454748;\" t-out=\"user.email or '-'\"/>\n"
"                                                </t>\n"
"                                                <t t-if=\"object.company_id.website\" data-oe-t-group=\"1\" data-oe-t-group-active=\"true\">\n"
"                                                    | <a t-attf-href=\"'%s' % {{ object.company_id.website }}\" style=\"text-decoration:none; color:#454748;\" t-out=\"object.company_id.website or '-'\"/>\n"
"                                                </t>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                        <tr>\n"
"                                            <td valign=\"middle\" align=\"left\" style=\"font-size:10px; color:#454748; padding-top:10px;\">\n"
"                                                De acuerdo con el RGPD, le informamos que trataremos sus datos personales con el fin de llevar a cabo la gestión administrativa, contable y fiscal. Los datos se conservarán proporcionalmente al tiempo exigido por una obligación legal y no serán transferidos a terceros, salvo requerimiento legal o, si procede, con el consentimiento previo del interesado. Podrá ejercer los siguientes derechos sobre sus datos personales: derecho de acceso, rectificación, supresión, limitación del tratamiento, oposición, portabilidad y retirada del consentimiento otorgado, dirigiéndose a la dirección indicada en este documento. Además, podrá ponerse en contacto con la autoridad de control competente en materia de protección de datos para obtener información adicional o presentar una reclamación.\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </tbody>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </td>\n"
"        </tr>\n"
"    </tbody>\n"
"</table>\n"
msgstr ""

