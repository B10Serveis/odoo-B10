<odoo>

<record id="damm_integration_reports_wizard_view_form" model="ir.ui.view">
    <field name="name">Generate Reports for Damm</field>
    <field name="model">damm_integration.reports.wizard</field>
    <field name="arch" type="xml">
        <form string="Generate Reports for Damm">
            <p class="alert alert-warning"
               attrs="{'invisible': [('damm_config_ok', '=', True)]}">
                Your Damm integration configuration may be missing some values, please check it.
            </p>
            <field name="damm_config_ok" invisible="1"/>
            <field name="report_type"/>
            <field name="date_start"/>
            <field name="date_end"/>
            <footer>
                <button type="object" name="generate_report" string="Generate" class="btn-primary"/>
                <button type="object" special="cancel" string="Cancel"/>
            </footer>
        </form>
    </field>
</record>

<record id="damm_integration_reports_wizard_action" model="ir.actions.act_window">
    <field name="name">Generate Reports for Damm</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">damm_integration.reports.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="damm_integration_reports_wizard_view_form"/>
    <field name="target">new</field>
</record>

<menuitem id="damm_integration_reports_wizard_menu"
          name="Reports" parent="damm_integration_base_menu"
          action="damm_integration_reports_wizard_action"/>

</odoo>
