<odoo>

<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.damm_integration</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="99"/>
    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//block[@name='integration']" position="inside">
            <setting string="Damm Integration"
                     help="Enable report creation for sending data to S.A. Damm."
                     id="damm_integration">
                <field name="group_damm_integration"/>
                <div class="content-group" invisible="not group_damm_integration">
                    <div class="mt16" groups="damm_integration.res_groups_damm_integration">
                        <label for="damm_dealer_code"/>
                        <field name="damm_dealer_code"/>
                        <div class="text-muted">
                            The code used by Damm to identify your company as a dealer of its products.
                        </div>
                    </div>
                    <div class="mt16" groups="damm_integration.res_groups_damm_integration">
                        <label for="damm_partner_id"/>
                        <field name="damm_partner_id"/>
                        <div class="text-muted">
                            The company (partner) S.A. Damm in your Odoo.
                        </div>
                    </div>
                </div>
            </setting>
        </xpath>
    </field>
</record>

</odoo>
