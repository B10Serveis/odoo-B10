<odoo>

<record id="view_company_form" model="ir.ui.view">
    <field name="name">Company: add Damm company</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
        <field name="favicon" position="after">
            <field name="damm_dealer_code"
                   groups="damm_integration.res_groups_damm_integration"
                   placeholder="Your company's Damm dealer code"/>
            <field name="damm_partner_id"
                   groups="damm_integration.res_groups_damm_integration"
                   placeholder="S.A. Damm in your Odoo"/>
        </field>
    </field>
</record>

</odoo>
