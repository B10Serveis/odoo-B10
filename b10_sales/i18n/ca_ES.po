"bold;\">\n"
"                                                                        <t t-out=\"object.name or "
"'n/a'\" data-oe-t-inline=\"true\" contenteditable=\"false\">\n"
"                                                                        </t>\n"
"                                                                    </span>\n"
"                                                                    <br/>\n"
"                                                                    Client: \n"
"                                                                    <t t-out=\"object.partner_id."
"name or object.partner_id.comercial or object.partner_id.parent_id.name or '-'\" data-oe-t-"
"inline=\"true\" contenteditable=\"false\">\n"
"                                                                    </t>\n"
