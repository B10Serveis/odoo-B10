<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sale_order_search_expired" model="ir.ui.view">
    <field name="name">sale.order.search.expired</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sales_order_filter"/>
    <field name="arch" type="xml">
      <!-- Filtre per veure només pressupostos caducats -->
      <xpath expr="//search" position="inside">
        <filter
          name="expired_quotes"
          string="Expired"
          domain="[
            ('state','in',('draft','sent')),
            ('validity_date','&lt;', context_today())
          ]"/>
      </xpath>
    </field>
  </record>
</odoo>
