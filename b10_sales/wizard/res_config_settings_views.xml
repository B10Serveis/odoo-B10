<odoo>
    <data>
        <record id="res_config_settings_view_form"
                model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.b10_sales</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id"
                   ref="sale.res_config_settings_view_form"/>
            <field name="arch"
                   type="xml">
                <xpath expr="//block[@name='quotation_order_setting_container']"
                       position="inside">
                  <setting id="b10_so_confirm_cancel"
                           help="Show a confirmation dialog when cancelling a sale order">
                      <field name="b10_so_confirm_cancel"/>
                  </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
