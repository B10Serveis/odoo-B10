<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="helpdesk_contract_ticket_view_form_B10"
            model="ir.ui.view">
            <field name="name">helpdesk_contract_B10</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id"
                ref="helpdesk_mgmt.ticket_view_form"/>
            <field name="arch"
                type="xml">
                <xpath expr="//field[@name='partner_email']"
                    position="after">
                    <field name="company_id"
                        invisible="1"/>
                    <field name="current_date"
                        invisible="1"/>
                    <field name="commercial_partner_id"
                        invisible="1"/>
                    <field name="related_contract"
                        options="{'no_create_edit': True}"
                        domain="[('partner_id', 'in', [partner_id, commercial_partner_id]), '|', ('company_id', '=', company_id), ('company_id', '=', False), '|', ('date_end', '&gt;=', current_date), ('date_end', '=', False)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
