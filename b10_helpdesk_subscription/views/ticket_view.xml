<odoo>
    <data>
        <record id="ticket_view_form_B10_subscriptions"
            model="ir.ui.view">
            <field name="name">helpdeskB10_subscriptions</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id"
                ref="helpdesk_mgmt.ticket_view_form"/>
            <field name="arch"
                type="xml">
                <xpath expr="//field[@name='partner_email']"
                    position="after">
                    <field name="company_id"
                        invisible="1"/>
                    <field name="subscription_current_date"
                        invisible="1"/>
                    <field name="related_subscription"
                        options="{'no_create_edit': True}"
                        domain="[('partner_id', '=', partner_id), ('company_id', '=', company_id), '|', ('date', '&gt;=', subscription_current_date), ('date', '=', False)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
