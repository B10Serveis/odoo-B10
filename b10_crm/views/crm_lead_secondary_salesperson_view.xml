<odoo>
  <record id="b10_crm.crm_lead_view_form_secondary_salesperson" model="ir.ui.view">
    <field name="name">crm.lead.form.secondary.salesperson</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form/sheet/group/group[@invisible=&quot;type == 'lead'&quot;]/field[@name='user_id']" position="after">
        <field name="secondary_user_id" domain="[('share', '=', False)]"/>
      </xpath>
      <xpath expr="//form/sheet/group/group[@invisible=&quot;type == 'opportunity'&quot;]/field[@name='user_id']" position="after">
        <field name="secondary_user_id" domain="[('share', '=', False)]"/>
      </xpath>
    </field>
  </record>
</odoo>
