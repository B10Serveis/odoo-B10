<odoo>
  <record id="b10_crm.crm_lead_view_form_secondary_salesperson" model="ir.ui.view">
    <field name="name">crm.lead.form.secondary.salesperson</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <field name="user_id" position="after">
        <field
          name="secondary_user_id"
          context="{
            'default_groups_ref': [
              'base.group_user',
              'base.group_partner_manager',
              'sales_team.group_sale_salesman_all_leads'
            ],
            'team_id': team_id
          }"
          domain="[('share','=',False)]"
        />
      </field>
    </field>
  </record>
</odoo>
