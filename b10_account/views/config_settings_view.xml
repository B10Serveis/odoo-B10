<odoo>
  <record id="b10_account.res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.form.b10.account</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@id='invite_users']" position="after">
        <div class="app_settings_block" data-string="B10 Settings" string="B10 Settings" data-key="b10_account">
          <h2>Facturació</h2>
          <div class="row mt16 o_settings_container">
            <div class="col-6 o_setting_box">
              <div class="o_setting_right_pane">
                <b>Group invoice lines by origin</b><br/>
                <small>Agrupar línies de factura per comanda d’origen</small><br/>
                <field name="invoice_lines_by_origin"/>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
