<odoo>
    <record id="b10_account.account_move_form_inherit"
        model="ir.ui.view">
        <field name="name">account.move.form.b10.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id"
            ref="account.view_move_form"/>
        <field name="arch"
            type="xml">
            <!-- Mostra els camps de configuració al formulari de venda -->
            <xpath expr="//group[@name='sale_info_group']"
                position="inside">
                <field name="group_by_origin"/>
                <field name="b10_display_payment_term_table"/>
            </xpath>
        </field>
    </record>
</odoo>
