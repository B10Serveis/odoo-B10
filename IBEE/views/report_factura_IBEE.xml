<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_factura_inherit_ibee" inherit_id="Dissenys_generics.report_factura_batista_document" priority="20">

            <xpath expr="//table[@id='b10_linetable']/thead" position="before">
                <t t-set="total_IBEE" t-value="sum(x.ibee_amount for x in doc.invoice_line_ids)"/>
            </xpath>
            <xpath expr="//table[@id='b10_linetable']/thead/tr/th[last()]" position="after">
                <th t-if="total_IBEE" class="text-end">IBEE</th>
            </xpath>
            <xpath expr="//table[@id='b10_linetable']/tbody[@class='invoice_tbody']//td[contains(@class, 'o_price_total')]" position="after">
                <td t-if="total_IBEE" class="text-end">
                    <span t-esc="line.ibee_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
            </xpath>
        </template>
    </data>
</odoo>
